<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WxSharpPackageVersion Condition="'$(WxSharpPackageVersion)' == ''">0.0.0-local</WxSharpPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WxSharp" Version="$(WxSharpPackageVersion)" />
  </ItemGroup>

</Project>

